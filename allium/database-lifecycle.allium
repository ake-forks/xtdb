-- allium: 3
-- database-lifecycle.allium
--
-- The lifecycle of a database on one node: how it becomes a member of the node's set, how it stops being one, and what resolves by name in between.
--
-- Scope: one node's set of databases, and the transitions between the states below.
-- Excludes: everything that happens INSIDE a running database.
-- Transaction processing, block flushing and query execution are db.allium's; leader election is log-processor-lifecycle.allium's.
-- Here a running database is opaque but for its reporting that ingestion has stopped, and for how far it had got when it did.
-- A database has made progress when the point it has reached is further on than at its last failure.
-- What ingestion is, what that point counts, and why it stops, are db.allium's; this spec carries only what the node does once it has.
--
-- The words below recur, and they nest.
--
-- - HOLD -- a record for this name exists on this node.
--   What `holds` tests.
--   A held name is occupied: no instruction can put a second record under it.
--
-- - MEMBER -- the node carries this database in the set it hands to the recorder.
--   The recorder replaces the durable membership record with that set, wholesale.
--   That record outlives every node, so membership is what keeps a database in existence.
--   Dropping one from the set -- deliberately, or by losing track of it -- deletes it.
--
-- - RESOLVE -- the catalog answers this name with a database ready to serve the caller.
--   A held name that does not resolve may have no database behind it, or one the catalog will not hand out.
--   What the database then does with the request -- how current its answer is, whether it is still taking in records -- is db.allium's.
--
-- A resolvable database is a member, and a member is held; neither converse holds.
--
-- The MEMBER axis only exists where a node writes the record back, and `membership_source` says which kind of node this is.
-- A durable_record node reads its set at startup and hands it to the recorder thereafter.
-- A fixed node is given its whole set by the operator and never writes one.
-- HOLD and RESOLVE apply to both.
-- The membership instructions and the membership surface exist only on a durable_record node.
-- A fixed node is told to admit and to remove nothing, so nothing on it is ever skipped or detached.
--
-- Attach and detach are cluster-wide instructions -- every node receives them and applies them to its own set independently.
-- This spec describes what ONE node does with them; how an instruction reaches the node belongs to db.allium.
--
-- The states a held name can be in.
--
-- - Open -- held, a member, resolvable.
--
-- - Recovering -- held, a member, and resolvable, with a replacement due.
--   Ingestion has stopped, and this node will open another database in its place.
--   Reads are still answered, at the basis it had reached.
--
-- - Stopped -- held, a member, and resolvable, with nothing being done about it.
--   Ingestion has stopped and this node will not restart the database: the fault is one that would recur identically, its attempts are spent, or it is the primary.
--   Reads are still answered, at the basis it had reached.
--
-- - Restarting -- held and a member, not resolvable.
--   The database behind the name has been released, and another is being opened in its place.
--   It stays a member throughout, because a set handed over without it would erase the database.
--
-- - Stranded -- held and a member, not resolvable.
--   Recovery ended with nothing behind the name.
--   An operator removes it or restarts the node; this node will do nothing further with it.
--
-- - Skipped -- held and a member, not resolvable.
--   The operator has designated that this node must not run it, and it stays in the set all the same.
--
-- - Detaching -- held only.
--   No longer a member, so already gone from the durable record, but still occupying its name until its resources are released.
--
-- A name this node has no entry for is ABSENT.
-- The node stores nothing for it, and cannot tell a name it was never told to admit from one it has finished removing.
-- Two things follow.
--
-- - The name is free, so an instruction to admit it is accepted.
--
-- - It is in no set the node hands over, which tells the recorder no such database exists.
--
-- Every state but Detaching stays a member, because a node that dropped one from its set would delete the database rather than leave it alone.
-- Detaching stays held because a database's resources have to be fully released before anything may take its place.
-- Its record keeps the name occupied for as long as that takes, while the removal itself has already taken effect.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity DatabaseConfig {
    -- The durable description of a database: where its log and storage live, and how it is to be run.
    -- Opaque here -- this spec carries it from instruction to entry and hands it back in the membership set, and never inspects it.
}

external entity Ingestion {
    -- The work a running database does to take in records and make them readable.
    -- Opaque here -- this spec observes only that it has stopped, and the point it had reached.
}

external entity Fault {
    -- Why ingestion stopped.
    -- Opaque but for whose fault it is: one in what was submitted recurs identically however many times the database is restarted.
    caller_fault: Boolean
}

external entity Cluster {
    -- The cluster-wide agreement about which databases exist.
    -- Instructions to admit or to remove reach every node from here; how they travel is db.allium's.
}

external entity Caller {
    -- Anything that asks this node to resolve a database by name: a query, a transaction submission, an operator tool.
}

external entity MembershipRecord {
    -- The cluster's durable record of which databases exist.
    -- It is rewritten wholesale from a node's membership set rather than amended.
    -- It is the only account of membership that survives every node, so it is also what a node reads its set back from when it starts.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Recovery {
    -- A run of failures a database has not got past.
    -- The count and the point reached begin, advance and end together, so they are one value: a database in no such run has none.
    attempts: Integer
    position: Integer
}

value ConfiguredDatabase {
    -- One entry in the set an operator hands a fixed node when it starts.
    name: String
    config: DatabaseConfig
}

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    catalog: DatabaseCatalog
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity DatabaseCatalog {
    -- The records one node holds.
    -- There is exactly one catalog per node.

    -- Where this node's set comes from, and whether it writes one back.
    -- A durable_record catalog reads its set when the node starts and hands it to the recorder from then on.
    -- A fixed catalog is given its whole set at startup and never writes one, so the MEMBER axis does not apply to it.
    -- It cannot delete a database by omission, because it never overwrites the record.
    membership_source: durable_record | fixed

    entries: DatabaseEntry with catalog = this

    -- Projections
    resolvable: entries where lifecycle in {Open, Recovering, Stopped}
    members: entries where lifecycle in {Open, Recovering, Stopped, Restarting, Stranded, Skipped}

    -- Derived
    -- Whether this node holds a record for a name, in any state.
    -- Its negation is the whole of what the node knows about an absent database: nothing.
    holds(db_name): entries.any(e => e.name = db_name)
}

entity DatabaseEntry {
    -- This node's record of a database: its name, the config it would run under, and whether it resolves.
    -- A record exists whether or not anything runs behind it -- a Skipped entry is a name and a config and nothing more.

    catalog: DatabaseCatalog
    name: String
    config: DatabaseConfig
    lifecycle: Open | Recovering | Stopped | Restarting | Stranded | Skipped | Detaching

    transitions lifecycle {
        Open -> Recovering
        Open -> Stopped
        Open -> Detaching
        Recovering -> Restarting
        Recovering -> Detaching
        Stopped -> Detaching
        Restarting -> Open
        Restarting -> Stranded
        Restarting -> Detaching
        terminal: Detaching, Skipped, Stranded
    }
}

variant Open : DatabaseEntry {
    -- The run of failures this database is in, and absent while it is in none.
    -- An Open database carries one across a restart, so a replacement that stops in the same place goes on counting rather than starting again.
    recovery: Recovery?
}

variant Recovering : DatabaseEntry {
    -- A replacement is due, so there is always a run behind it.
    recovery: Recovery
}

variant Restarting : DatabaseEntry {
    -- A restart follows a failure, so there is always a run behind it.
    recovery: Recovery
}

variant Stopped : DatabaseEntry {
    -- Why ingestion stopped, and why nothing is being done about it.
    fault: Fault
}

variant Stranded : DatabaseEntry {
    -- Why recovery ended.
    fault: Fault
}

variant Skipped : DatabaseEntry { }

variant Detaching : DatabaseEntry { }

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Databases the operator has designated this node must not run.
    -- Named rather than removed, so that they stay members.
    skipped_databases: Set<String> = {}

    -- The database every node has as a member, and the only one that cannot be removed.
    primary_database: String = "xtdb"

    -- How long a run of failures may get, counting the one that began it, before the database is left alone.
    -- Spending them leaves it readable and reported rather than removed, so an operator still finds it where they left it.
    max_restart_attempts: Integer = 8

    -- A fixed node's whole set, supplied by the operator when the node starts.
    -- Empty on a durable_record node, which reads its set instead.
    fixed_databases: Set<ConfiguredDatabase> = {}
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

---- Entries coming into being

rule StartupCreatesFixedSet {
    -- A fixed node's whole set arrives at once, when the node starts.
    -- There is no instruction to respond to and no record to read.
    -- The operator supplies the set, and it does not change for as long as the node runs.
    when: NodeStarted()
    requires: catalog.membership_source = fixed

    for configured in config.fixed_databases:
        ensures: Open.created(
            catalog: catalog, name: configured.name, config: configured.config, recovery: null
        )
}

rule AdmitInstructionCreatesEntry {
    -- An instruction naming something this node does not hold makes it a member: the record comes into being and joins the set either way.
    -- It resolves too, unless the operator has designated it as one to skip.
    -- A Skipped name is still a member, because membership is what keeps a database in existence.
    when: NodeInstructedToAdmit(db_name, db_config)
    requires: catalog.membership_source = durable_record
    requires: not catalog.holds(db_name)

    ensures:
        if db_name in config.skipped_databases:
            Skipped.created(
                catalog: catalog, name: db_name, config: db_config
            )
        else:
            Open.created(
                catalog: catalog, name: db_name, config: db_config, recovery: null
            )
}

rule AdmitRefusedWhenAlreadyHeld {
    -- A name identifies at most one database per node, so an instruction naming one this node already holds is refused rather than replacing it.
    -- This holds however the held database is faring: one that has already ceased to be a member still occupies its name until it is gone.
    when: NodeInstructedToAdmit(db_name, db_config)
    requires: catalog.membership_source = durable_record
    requires: catalog.holds(db_name)

    ensures: AdmitRefused(db_name: db_name)
}

---- Ingestion stopping, and the database coming back

rule FailureBeginsARunOfRecovery {
    -- A database that stops ingesting is due to be replaced, so that a fault which has since cleared costs no more than the time to notice it.
    -- It answers reads at the basis it had reached until the replacement is opened.
    -- The count bounds a run of failures, not a database's lifetime, so one that got further than it did last time is restarted as freely as one that never failed.
    when: IngestionStopped(db_name, fault, position)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: exists entry
    requires: entry.lifecycle = Open
    requires: db_name != config.primary_database
    requires: not fault.caller_fault
    requires: entry.recovery = null or position > entry.recovery.position

    ensures: entry.lifecycle = Recovering
    ensures: entry.recovery = Recovery(attempts: 1, position: position)
}

rule RepeatedFailureContinuesTheRun {
    -- A database that got no further than last time has recovered from nothing, so this failure counts against what recovery it has left.
    -- It answers reads meanwhile, as one whose run has just begun does.
    when: IngestionStopped(db_name, fault, position)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: exists entry
    requires: entry.lifecycle = Open
    requires: db_name != config.primary_database
    requires: not fault.caller_fault
    requires: entry.recovery != null and position <= entry.recovery.position
    requires: entry.recovery.attempts < config.max_restart_attempts

    ensures: entry.lifecycle = Recovering
    ensures: entry.recovery = Recovery(attempts: entry.recovery.attempts + 1, position: position)
}

rule PrimaryIsNotRestarted {
    -- A restart rewinds a database to its last durable point and replays from there, which is safe only for state that database owns.
    -- The primary's log processor also applies the cluster's membership instructions, and those mutate the node's catalog.
    -- No restart of one database rewinds that, so a replayed instruction meets its own earlier effect and resolves a second time -- and it is the resolution, not the instruction, that every node applies.
    when: IngestionStopped(db_name, fault, position)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: exists entry
    requires: entry.lifecycle = Open
    requires: db_name = config.primary_database

    ensures: entry.lifecycle = Stopped
    ensures: entry.fault = fault
}

rule FailureStopsDatabase {
    -- The database stays where it is, readable and reported, and this node does nothing further with it.
    -- A caller fault would recur identically on every attempt; a run of failures that got no further each time has bought all the recovery on offer.
    when: IngestionStopped(db_name, fault, position)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: exists entry
    requires: entry.lifecycle = Open
    requires: db_name != config.primary_database
    requires: fault.caller_fault or (entry.recovery != null and position <= entry.recovery.position and entry.recovery.attempts >= config.max_restart_attempts)

    ensures: entry.lifecycle = Stopped
    ensures: entry.fault = fault
}

rule ReplacementBeginsRestart {
    -- A node judges for itself when a replacement is due, and it MAY wait longer after each failure of a run.
    -- The name stops resolving at this point, where the database behind it is released.
    when: ReplacementDue(entry)
    requires: entry.lifecycle = Recovering

    ensures: entry.lifecycle = Restarting
}

rule ReplacementCompletesRestart {
    -- The database behind the name is a new one, holding no more than the durable record it read on the way up.
    -- Its run carries over untouched, so one that opens and stops in the same place is not restarted afresh.
    when: ReplacementOpened(entry)
    requires: entry.lifecycle = Restarting

    ensures: entry.lifecycle = Open
}

rule AbandonedRecoveryStrandsDatabase {
    -- The name keeps its place in the set, so that a node which gave up does not thereby delete the database.
    when: RecoveryAbandoned(entry, fault)
    requires: entry.lifecycle = Restarting

    ensures: entry.lifecycle = Stranded
    ensures: entry.fault = fault
}

---- Entries going away

rule PrimaryCannotBeRemoved {
    -- Every node has the primary as a member, and no instruction removes it.
    -- It is the one entry whose presence anything reading this node may assume.
    when: NodeInstructedToRemove(db_name)
    requires: catalog.membership_source = durable_record
    requires: db_name = config.primary_database

    ensures: RemoveRefused(db_name: db_name)
}

rule RemoveRefusedForAbsentName {
    -- An instruction naming something this node does not hold has nothing to act on.
    -- The node cannot tell whether it never held the name or has already finished removing it; either way there is nothing here to remove.
    when: NodeInstructedToRemove(db_name)
    requires: catalog.membership_source = durable_record
    requires: db_name != config.primary_database
    requires: not catalog.holds(db_name)

    ensures: RemoveRefused(db_name: db_name)
}

rule RemoveBeginsTeardown {
    -- An Open database is torn down before it goes.
    -- It stops resolving and stops being a member the moment the instruction arrives, so it is already out of the durable record.
    -- It goes on being held while its resources are released.
    when: NodeInstructedToRemove(db_name)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: catalog.membership_source = durable_record
    requires: db_name != config.primary_database
    requires: exists entry
    requires: entry.lifecycle in {Open, Recovering, Stopped, Restarting}

    ensures: entry.lifecycle = Detaching
}

rule RemoveDropsSkippedEntry {
    -- A Skipped database has nothing behind it, so it has nothing to release and goes straight out.
    when: NodeInstructedToRemove(db_name)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: catalog.membership_source = durable_record
    requires: db_name != config.primary_database
    requires: exists entry
    requires: entry.lifecycle = Skipped

    ensures: not exists entry
}

rule RemoveDropsStrandedEntry {
    -- Nothing is behind a Stranded name, so it has nothing to release and goes straight out.
    when: NodeInstructedToRemove(db_name)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: catalog.membership_source = durable_record
    requires: db_name != config.primary_database
    requires: exists entry
    requires: entry.lifecycle = Stranded

    ensures: not exists entry
}

rule RemoveRefusedWhileTearingDown {
    -- Already on its way out; a second instruction has nothing left to do.
    when: NodeInstructedToRemove(db_name)
    let entry = DatabaseEntry{catalog, name: db_name}
    requires: catalog.membership_source = durable_record
    requires: db_name != config.primary_database
    requires: exists entry
    requires: entry.lifecycle = Detaching

    ensures: RemoveRefused(db_name: db_name)
}

rule TeardownCompletesRemoval {
    -- The record goes only once the database has released its resources.
    -- Until then it occupies its name, which is what stops a re-admission racing its own teardown.
    when: TeardownCompleted(entry)
    requires: entry.lifecycle = Detaching

    ensures: not exists entry
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneEntryPerNamePerNode {
    -- Within a node a name identifies at most one record.
    -- Across nodes the same name recurs by design: every node holds the primary, and a database is normally a member everywhere.
    for a in DatabaseEntries:
        for b in DatabaseEntries:
            a != b and a.catalog = b.catalog implies a.name != b.name
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Client {
    identified_by: Caller where true
}

actor ClusterControl {
    identified_by: Cluster where true
}

actor Ingester {
    identified_by: Ingestion where true
}

actor Recorder {
    identified_by: MembershipRecord where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface MembershipInstructions {
    facing cluster: ClusterControl

    provides:
        NodeInstructedToAdmit(cluster, db_name, db_config)
        NodeInstructedToRemove(cluster, db_name)

    @guarantee OnlyRecordBackedNodesTakeInstructions
        -- Instructions reach only a catalog whose `membership_source` is durable_record.
        -- A fixed node is given its set at startup and takes none.

    @guarantee EveryNodeDecidesForItself
        -- An instruction reaches every node and each applies it to its own set.
        -- A node that refuses one does not thereby refuse it on any other node's behalf.

    @guarantee RefusalLeavesTheSetUnchanged
        -- Refusing an instruction leaves this node's set exactly as it was.
}

surface IngestionSignals {
    facing ingester: Ingester

    provides:
        IngestionStopped(ingester, db_name, fault, position)

    @guarantee StoppingIsReportedOnce
        -- A database reports that its ingestion has stopped once; the next such report comes from the database that replaced it.

    @guarantee StoppingCarriesThePointReached
        -- The point a database reports is the one it had reached when its ingestion stopped, and it does not go backwards between a database and the one that replaced it.
        -- A node has no other way to tell a database recovering between failures from one failing in the same place every time, and the two are owed different treatment.

    @guarantee RecoveryIsBoundedByFailuresSinceProgress
        -- A run of failures is at most `max_restart_attempts` long, counting the one that began it, and the database is replaced after each of them.
        -- A failure at a further point begins a new run, so a database that fails after periods of progress goes on being replaced.
}

surface DatabaseResolution {
    facing caller: Client

    context node_catalog: DatabaseCatalog

    exposes:
        for entry in node_catalog.resolvable:
            entry.name

    provides:
        ResolveDatabase(caller, db_name)

    @guarantee ResolutionNeedsADatabaseToAnswer
        -- A name resolves only while this node holds a database behind it ready to answer.
        -- Of any other held name a caller sees nothing at all: not the name, not that it exists.
        -- It therefore cannot tell one from a name this node never held.
}

surface Membership {
    facing recorder: Recorder

    context node_catalog: DatabaseCatalog where membership_source = durable_record

    exposes:
        for entry in node_catalog.members:
            entry.name
            entry.config

    @guarantee DeclinedDatabasesStayMembers
        -- The membership set carries every database this node knows of and has not been told to remove, including ones it has declined to run.

    @guarantee AbsenceAssertsNonExistence
        -- Handing over a set without a name in it asserts that no such database exists.
        -- The recorder takes the set as the whole truth and replaces the previous record with it.
        -- A node that has merely lost track of one -- rather than been told to remove it -- erases it by doing so.
        -- Nothing later restores it, because the record it overwrote is the only one that survives the node.

    @guarantee MembershipEndsOnInstruction
        -- A database under instruction to be removed leaves the membership set when the instruction arrives, not when its teardown finishes.
        -- The instruction is what decides membership.
        -- How long this node then takes to release resources is local to it, and does not reach the durable record.
}
